{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "gen:api": "uv run --project ../backend python ../scripts/export_openapi.py > openapi.json && openapi-typescript openapi.json -o src/api/schema.d.ts",
